# Copy this file to .env and fill in real values

# Database
# For local dev without Postgres installed, sqlite works out of the box:
DATABASE_URL=sqlite:///./insightflow.db
# For production, use Postgres:
# DATABASE_URL=postgresql://insightflow_user:password@localhost:5432/insightflow

# JWT Auth
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AI_PROVIDER=ollama

# App
UPLOAD_DIR=uploads
ENV=development
